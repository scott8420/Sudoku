<?xml version="1.0" encoding="UTF-8"?>
<!--
  App resources. The icon is placed under the icon-theme resource layout
  (<base>/icons/scalable/apps/<name>.svg) so that, once the app adds
  "/io/github/example/Sudoku/icons" to the icon theme's resource path, the
  themed icon "io.github.example.Sudoku-symbolic" resolves by name -- used for
  the window icon and the About-dialog logo. The "-symbolic" name makes GTK
  recolor it to the foreground, so it stays visible on light or dark chrome.

  Prefix is derived from the app ID (io.github.example.Sudoku). When the real
  reverse-DNS ID is chosen, this prefix, the SVG filename, the .desktop name,
  and the icon-name strings in the code all rename together.
-->
<gresources>
  <gresource prefix="/io/github/example/Sudoku/icons/scalable/apps">
    <file>io.github.example.Sudoku.svg</file>
    <file>io.github.example.Sudoku-symbolic.svg</file>
  </gresource>
</gresources>
